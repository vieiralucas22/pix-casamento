# Mercado Pago access token (server-only — never expose with a NEXT_PUBLIC_ prefix).
# Use a TEST token to try things out, your PRODUCTION token to go live.
# Get both from https://www.mercadopago.com.br/developers/panel/app > your app > "Credenciais".
MERCADOPAGO_ACCESS_TOKEN=

# Shared payer identity used for every guest's Pix charge (Mercado Pago requires
# an email + CPF on every Pix payment — see "Mercado Pago setup" in README.md).
MERCADOPAGO_PAYER_EMAIL=
MERCADOPAGO_PAYER_CPF=

# Secret signature from the webhook configuration screen in the Mercado Pago
# dashboard, used to validate the x-signature header on incoming webhook calls.
MERCADOPAGO_WEBHOOK_SECRET=
